# Test database configuration for integration tests.
# NEVER point this to your production Neon database.
# Recommended: create a separate local Postgres DB or a separate Neon branch/database with "test" in the name.

# Example local:
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/animated_disco_test?schema=public"

# Example Neon test branch/database:
# TEST_DATABASE_URL="postgresql://user:password@ep-your-test-branch-pooler.region.aws.neon.tech/animated_disco_test?sslmode=require"

# Required only for reset script:
# ALLOW_TEST_DB_RESET=true

# If your remote test URL does not visibly contain "test", set this only after confirming it is NOT production:
# ALLOW_REMOTE_TEST_DATABASE_URL=true
