# XNRT / Animated Disco environment example
# Copy this file to .env and fill real values.
# Never commit .env or private keys.

# ─────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5000

# ─────────────────────────────────────────────────────────────
# Database / Prisma
# ─────────────────────────────────────────────────────────────
# Neon/Postgres connection string. Use the pooler URL for serverless/production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional: skip default Tasks/Achievements seed during local DB troubleshooting.
SKIP_STARTUP_SEEDS=false

# ─────────────────────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# ─────────────────────────────────────────────────────────────
# Email / SMTP
# ─────────────────────────────────────────────────────────────
# Current code uses Brevo SMTP host/user defaults and reads SMTP_PASSWORD.
# Future deployments may support SMTP_HOST/SMTP_PORT/SMTP_USER too.
SMTP_PASSWORD=replace-with-smtp-password
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
EMAIL_FROM=no-reply@xnrt.org

# ─────────────────────────────────────────────────────────────
# Wallet / Deposit / Withdrawal rates
# ─────────────────────────────────────────────────────────────
# 1 USDT = 100 XNRT by default.
XNRT_RATE_USDT=100
# Withdrawal fee percent. Example: 2 = 2%.
WITHDRAWAL_FEE_PERCENT=2
# Platform deposit fee in basis points. Example: 100 = 1%.
PLATFORM_FEE_BPS=0

# ─────────────────────────────────────────────────────────────
# BSC / blockchain verification
# ─────────────────────────────────────────────────────────────
RPC_BSC_URL=https://bsc-dataseed.binance.org/
USDT_BSC_ADDRESS=0x55d398326f99059fF775485246999027B3197955
XNRT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
XNRT_WALLET=0x0000000000000000000000000000000000000000
BSC_CONFIRMATIONS=12
BSC_SCAN_BATCH=300
BSC_START_FROM=latest

# Enables automatic blockchain scanner. Recommended false in local dev.
ENABLE_SCANNER=false
AUTO_DEPOSIT=false

# Private key used only if token service/minting is enabled.
# Never expose this in client-side code.
DEPLOYER_PRIVATE_KEY=

# HD wallet seed for generating personal deposit addresses.
# Use a secure random seed/mnemonic in production and store it as a secret.
MASTER_SEED=replace-with-secure-production-seed-or-mnemonic

# ─────────────────────────────────────────────────────────────
# Deposit proof storage
# ─────────────────────────────────────────────────────────────
DEPOSIT_PROOF_UPLOAD_DIR=uploads/deposit-proofs
DEPOSIT_PROOF_MAX_BYTES=2097152

# ─────────────────────────────────────────────────────────────
# Referral/company fallback
# ─────────────────────────────────────────────────────────────
REFERRAL_COMPANY_EMAIL=
COMPANY_ADMIN_EMAIL=

# ─────────────────────────────────────────────────────────────
# Push notifications / VAPID
# Generate keys with: npx web-push generate-vapid-keys
# ─────────────────────────────────────────────────────────────
ENABLE_PUSH_NOTIFICATIONS=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@xnrt.org

# ─────────────────────────────────────────────────────────────
# Monitoring
# ─────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=

# Feature flags JSON. Example:
# VITE_FEATURE_FLAGS={"pwa":{"offline":true,"push":true,"realtime":false},"ux":{"animations":true,"haptics":false,"sounds":true},"admin":{"analytics":true,"advancedFeatures":true}}
VITE_FEATURE_FLAGS=

# ─────────────────────────────────────────────────────────────
# Test database
# ─────────────────────────────────────────────────────────────
# Use a disposable database only. Never point this to production.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/animated_disco_test?schema=public
ALLOW_TEST_DB_RESET=false

# ─────────────────────────────────────────────────────────────
# Development-only verification override
# Do not enable in production.
# ─────────────────────────────────────────────────────────────
ALLOW_VERIFY_OVERRIDE=0
FORCE_OVERRIDE_IN_PROD=0
VERIFY_OVERRIDE_PREFIX=
OVERRIDE_CONFIRMATIONS=12
